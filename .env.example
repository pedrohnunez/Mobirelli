VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Só usada no servidor (função api/admin-usuarios.js), pra criar/gerenciar logins.
# NUNCA prefixe com VITE_ — isso faria ela ir junto no JavaScript do site, visível pra
# qualquer um. Pegue em: Supabase > Project Settings > API > "service_role" secret.
# Cadastre só na Vercel (Project Settings > Environment Variables), não precisa dela
# rodando localmente a não ser que você teste a tela de Usuários na sua máquina.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
